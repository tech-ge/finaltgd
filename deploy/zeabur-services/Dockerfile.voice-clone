FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libsndfile1 ffmpeg \
 && rm -rf /var/lib/apt/lists/*

COPY deploy/huggingface-ai/voice-clone-space/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY deploy/huggingface-ai/voice-clone-space/app.py ./app.py

RUN useradd --create-home --shell /bin/bash appuser
USER appuser

EXPOSE 7860

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "7860"]
