{
  "title": "TechGeo Ledger",
  "uid": "techgeo-ledger",
  "schemaVersion": 39,
  "panels": [
    {
      "title": "Transfer rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(ledger_transfers_total[1m])", "legendFormat": "transfers/s" }
      ]
    },
    {
      "title": "Transfer errors",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(ledger_transfer_errors_total[1m])", "legendFormat": "errors/s" }
      ]
    }
  ]
}
