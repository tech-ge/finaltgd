{
  "name": "techgeo",
  "version": "0.1.0",
  "private": true,
  "description": "TechGeo Global Unified Agentic Ecosystem",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11.0", "pnpm": ">=9.0.0" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:seed": "bash scripts/db-seed.sh",
    "infra:up": "bash scripts/dev-up.sh",
    "infra:down": "bash scripts/dev-down.sh",
    "deploy:render": "bash scripts/deploy-render.sh",
    "deploy:zeabur": "bash scripts/deploy-zeabur.sh",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "deploy:hf": "bash scripts/deploy-huggingface.sh",
    "deploy:cf": "bash scripts/deploy-cloudflare.sh",
    "build:apk": "bash scripts/build-apk.sh",
    "build:ios": "bash scripts/build-ios.sh",
    "train:shadow": "bash scripts/train-shadow.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
